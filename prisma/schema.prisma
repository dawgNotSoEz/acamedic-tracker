generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roadmap {
  id          String   @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]   @relation("RoadmapTasks")
  weeks       Week[]   @relation("RoadmapWeeks")

  @@index([title])
  @@map("roadmaps")
}

model Week {
  id        String    @id @default(uuid())
  roadmapId String
  number    Int
  title     String?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  days      Day[]     @relation("WeekDays")
  tasks     Task[]    @relation("WeekTasks")
  roadmap   Roadmap   @relation("RoadmapWeeks", fields: [roadmapId], references: [id])

  @@unique([roadmapId, number])
  @@index([roadmapId])
  @@map("weeks")
}

model Day {
  id        String    @id @default(uuid())
  weekId    String
  dayNumber Int
  date      DateTime?
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  week      Week      @relation("WeekDays", fields: [weekId], references: [id])
  tasks     Task[]    @relation("DayTasks")

  @@unique([weekId, dayNumber])
  @@index([weekId])
  @@index([date])
  @@map("days")
}

model Task {
  id           String         @id @default(uuid())
  roadmapId    String?
  weekId       String?
  dayId        String?
  title        String
  description  String?
  estimateMins Int?
  status       TaskStatus     @default(TODO)
  priority     Priority       @default(MEDIUM)
  category     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     StudySession[]
  resources    TaskResource[]
  day          Day?           @relation("DayTasks", fields: [dayId], references: [id])
  roadmap      Roadmap?       @relation("RoadmapTasks", fields: [roadmapId], references: [id])
  week         Week?          @relation("WeekTasks", fields: [weekId], references: [id])

  @@index([roadmapId])
  @@index([weekId])
  @@index([dayId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tasks")
}

model Resource {
  id         String         @id @default(uuid())
  title      String
  type       String
  url        String?
  content    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  category   String?
  difficulty Difficulty?    @default(MEDIUM)
  tags       ResourceTag[]
  sessions   StudySession[]
  tasks      TaskResource[]

  @@index([type])
  @@index([createdAt])
  @@map("resources")
}

model Tag {
  id        String        @id @default(uuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  resources ResourceTag[]

  @@map("tags")
}

model ResourceTag {
  id         String   @id @default(uuid())
  resourceId String
  tagId      String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id])
  tag        Tag      @relation(fields: [tagId], references: [id])

  @@unique([resourceId, tagId])
  @@index([resourceId])
  @@index([tagId])
  @@map("resource_tags")
}

model TaskResource {
  id         String   @id @default(uuid())
  taskId     String
  resourceId String
  createdAt  DateTime @default(now())
  resource   Resource @relation(fields: [resourceId], references: [id])
  task       Task     @relation(fields: [taskId], references: [id])

  @@unique([taskId, resourceId])
  @@index([taskId])
  @@index([resourceId])
  @@map("task_resources")
}

model StudySession {
  id                   String             @id @default(uuid())
  taskId               String?
  resourceId           String?
  startAt              DateTime
  endAt                DateTime?
  durationMins         Int?
  notes                String?
  category             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  accumulatedMins      Int                @default(0)
  currentIntervalStart DateTime?
  status               StudySessionStatus @default(PAUSED)
  resource             Resource?          @relation(fields: [resourceId], references: [id])
  task                 Task?              @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@index([resourceId])
  @@index([startAt])
  @@index([currentIntervalStart])
  @@index([endAt])
  @@index([status])
  @@index([createdAt])
  @@index([category])
  @@map("study_sessions")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  STOPPED
}
